# ---------- PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox) ----------
# Leave blank to run in SIMULATED_SANDBOX mode (PayPal-shaped IDs, no network call).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: enables cryptographic webhook-signature verification (Dashboard -> Webhooks)
PAYPAL_WEBHOOK_ID=
# If a live sandbox call fails (network/credentials), fall back to the simulated verifier
PAYPAL_FALLBACK_SIMULATE=true
# Public origin PayPal redirects the approval popup back to (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8000

# ---------- LLM (optional - deterministic reasoning engine is used when no key is set) ----------
# Provider is inferred from whichever key is set, or force it: openai | anthropic | gemini | groq
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---------- App ----------
DATABASE_URL=sqlite:///./elasticpay.db
RECEIPT_SECRET=change-me
# Seconds between streamed trace lines in deterministic mode (cosmetic)
AGENT_TRACE_PACE=0.4
